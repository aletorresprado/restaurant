    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@prisma/client": "^6.2.1",
    "@repo/config": "workspace:*",
    "@repo/shared-types": "workspace:*",
    "@repo/validation": "workspace:*",
    "bcryptjs": "3.0.2",
