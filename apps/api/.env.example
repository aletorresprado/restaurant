# Base de datos
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/app_resto_dev"

# JWT
JWT_ACCESS_SECRET="cambia-este-secret-en-produccion"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="cambia-este-refresh-secret-en-produccion"
JWT_REFRESH_EXPIRES_IN="7d"

# Servidor
PORT=3000
NODE_ENV="development"

# Timezone (referencia — la logica usa BUSINESS_CONFIG.timezone de @repo/config)
TZ="America/Argentina/Tucuman"