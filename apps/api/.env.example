# Base de datos
DATABASE_URL="postgresql://app_resto:local_dev_only@localhost:5432/app_resto_dev"

# JWT
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
# Los refresh tokens son aleatorios y solo se guarda su hash; no necesitan secreto JWT.
JWT_REFRESH_EXPIRES_IN="7d"

# Servidor
PORT=3000
NODE_ENV="development"

# Timezone (referencia — la logica usa BUSINESS_CONFIG.timezone de @repo/config)
TZ="America/Argentina/Tucuman"

# Solo necesarios para pnpm db:seed. No se crea un administrador automáticamente.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
