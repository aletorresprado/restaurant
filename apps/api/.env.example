# Base de datos
DATABASE_URL="postgresql://app_resto:local_dev_only@localhost:5432/app_resto_dev"

# JWT
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
# Los refresh tokens son aleatorios y solo se guarda su hash; no necesitan secreto JWT.
JWT_REFRESH_EXPIRES_IN="7d"

# Servidor
PORT=3000
NODE_ENV="development"

# La web usa el mismo origen que /api/v1 (proxy Vite en desarrollo).
# En produccion: lista explicita de origenes HTTPS, sin rutas ni barra final.
WEB_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"
WEB_SESSION_HOURS=8

# Limites por IP e instancia (no usar multiples instancias sin contador compartido).
# Ventanas: login 15 min, registro 1 hora, los demas 1 minuto. No admite 0.
RATE_LIMIT_LOGIN=30
RATE_LIMIT_REGISTER=10
RATE_LIMIT_REFRESH=60
RATE_LIMIT_WRITE=120
RATE_LIMIT_READ=300
# Vacio: no confiar en X-Forwarded-For. Configurar solo IPs de proxies controlados.
TRUSTED_PROXY_IPS=""
# Fallos por correo normalizado en 15 minutos; pausa temporal sin prorroga por rechazos.
LOGIN_ACCOUNT_FAILURES=5
LOGIN_ACCOUNT_PAUSE_SECONDS=60

# Enlaces publicos (origen exacto). file: solo desarrollo local, no envia email real.
PUBLIC_WEB_URL="http://127.0.0.1:5173"
MAIL_MODE="file"
MAIL_OUTBOX_DIR=".local/mail"
RATE_LIMIT_ACCOUNT_REQUEST=5
RATE_LIMIT_ACCOUNT_CONFIRM=30
# SMTP opcional: nunca versionar valores reales. Puerto 465 usa TLS; otros exigen STARTTLS.
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASSWORD=""
# MAIL_FROM=""

# Timezone (referencia — la logica usa BUSINESS_CONFIG.timezone de @repo/config)
TZ="America/Argentina/Tucuman"

# Solo necesarios para pnpm db:seed. No se crea un administrador automáticamente.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
